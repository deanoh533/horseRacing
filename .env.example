# ============================================
# KRA Analyzer - 환경 변수 템플릿
# ============================================
# 사용법:
# 1. 이 파일을 .env로 복사 (cp .env.example .env)
# 2. 각 값을 실제 키로 변경
# 3. .env 파일은 절대 git에 커밋 X
# ============================================

# --- KRA 공공데이터 포털 API ---
# 공공데이터 포털 (data.go.kr)에서 발급받은 인증키
KRA_API_KEY=your_kra_api_key_here

# --- Supabase ---
# Supabase 프로젝트 설정 (https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Postgres 직접 연결 (마이그레이션용)
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# --- Claude API (Anthropic) ---
# console.anthropic.com에서 발급
# 형식: sk-ant-api03-XXXXXXXXX...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI 사용 한도 (월 USD)
ANTHROPIC_MONTHLY_LIMIT=5
ANTHROPIC_DAILY_LIMIT=0.20

# --- 앱 설정 ---
NODE_ENV=development
PORT=3000

# --- 동기화 설정 ---
# Cron 표현식 (매일 새벽 3시)
SYNC_CRON_SCHEDULE="0 3 * * *"

# 백테스트 데이터 기간 (일)
BACKTEST_DAYS=730
