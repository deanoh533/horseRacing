# ============================================
# KRA Analyzer Client (Frontend) - 환경 변수 템플릿
# ============================================
# 사용법:
# 1. 이 파일을 client/.env로 복사
# 2. 각 값을 실제 키로 변경
# 3. Vercel 배포 시에도 동일한 값을 Project Settings → Environment Variables 에 등록
#
# ⚠️ VITE_ 접두사가 붙은 변수만 브라우저 번들에 포함됩니다.
# ⚠️ Service role key 는 절대 여기에 넣지 마세요 (anon key 만 사용).
# ============================================

# --- Supabase (Frontend - anon key 만, RLS 로 보호) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
