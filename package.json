{
  "name": "kra-analyzer",
  "version": "0.1.0",
  "description": "KRA 한국 경마 분석 도구 (개인용)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync": "tsx src/sync/dailySync.ts",
    "sync:full": "tsx src/sync/onboardingSync.ts",
    "sync:cards": "tsx src/sync/raceCardSync.ts",
    "sync:cards:bulk": "tsx scripts/backfill_race_cards.ts",
    "backfill": "tsx scripts/backfill_predictions.ts",
    "walkforward": "tsx scripts/walkforward_eval.ts",
    "learn:candidate": "tsx scripts/learn_candidate.ts",
    "promote": "tsx scripts/promote_version.ts",
    "build:rho-history": "tsx scripts/build_rho_history.ts",
    "benchmark": "tsx scripts/benchmark_all.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "sync:sectional": "tsx src/sync/sectionalSync.ts",
    "sync:training": "tsx src/sync/trainingSync.ts",
    "sync:jockey": "tsx src/sync/jockeySync.ts",
    "extract:matrix": "tsx scripts/extract_training_matrix.ts",
    "exp:logistic": "tsx scripts/experiment_logistic.ts",
    "probe:edge": "tsx scripts/probe_market_edge.ts",
    "backtest:value": "tsx scripts/backtest_value_betting.ts",
    "collect:combo": "tsx scripts/collect_combo_dividends.ts",
    "collect:prize": "tsx scripts/collect_prize.ts",
    "backtest:combo": "tsx scripts/backtest_combo_betting.ts",
    "learn:logistic": "tsx scripts/learn_logistic.ts",
    "verify:logistic": "tsx scripts/verify_logistic.ts",
    "refresh:logistic": "tsx scripts/refresh_logistic.ts",
    "backtest:box": "tsx scripts/backtest_box.ts",
    "backtest:box:quarters": "tsx scripts/backtest_box_quarters.ts",
    "probe:corr": "tsx scripts/probe_feature_corr.ts",
    "exp:pl": "tsx scripts/experiment_pl.ts",
    "db:pull": "tsx scripts/sync_local_db.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@duckdb/node-api": "^1.5.3-r.3",
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.7.0",
    "date-fns": "^4.0.0",
    "dotenv": "^16.4.0",
    "fast-xml-parser": "^4.5.0",
    "p-limit": "^6.1.0",
    "simple-statistics": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.13.0",
    "pg": "^8.21.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
